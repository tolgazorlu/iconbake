{
  "name": "iconpress",
  "version": "0.1.0",
  "description": "Local app icon generator: a glyph, a background and a shape in, a store-ready iOS/Android/macOS/web icon set out. CLI, UI and MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tolgazorlu/iconpress.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "mcp": "node dist-cli/iconpress.js mcp",
    "build:cli": "vite build -c vite.cli.config.ts && chmod +x dist-cli/iconpress.js",
    "typecheck:cli": "tsc -p tsconfig.cli.json",
    "test": "pnpm build:cli && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@iconify/json": "^2.2.537",
    "@iconify/utils": "^3.1.7",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-js": "^2.6.2",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "bin": {
    "iconpress": "dist-cli/iconpress.js"
  }
}
